    {
      "cell_type": "code",
      "source": "import matplotlib.pyplot as plt\n\nmethods = ['Full Fine-Tuning', 'LoRA (PEFT)']\naccuracy = [full_acc*100, lora_acc*100]\ntime_min = [full_time/60, lora_time/60]\nmemory_gb = [full_mem, lora_mem]\n\nx = np.arange(len(methods))\nwidth = 0.25\n\nfig, ax1 = plt.subplots(figsize=(12, 8))\n\n# Accuracy bars\nbars1 = ax1.bar(x - width, accuracy, width, label='Accuracy (%)', color='#1f77b4')\nax1.set_ylabel('Accuracy (%)', color='#1f77b4', fontsize=12)\nax1.set_ylim(90, 95)\n\n# Time bars (secondary axis)\nax2 = ax1.twinx()\nbars2 = ax2.bar(x, time_min, width, label='Training Time (min)', color='#ff7f0e')\nax2.set_ylabel('Training Time (minutes)', color='#ff7f0e', fontsize=12)\nax2.set_ylim(0, 90)\n\n# Memory bars\nax3 = ax1.twinx()\nax3.spines['right'].set_position(('outward', 60))\nbars3 = ax3.bar(x + width, memory_gb, width, label='GPU Memory (GB)', color='#2ca02c')\nax3.set_ylabel('Peak GPU Memory (GB)', color='#2ca02c', fontsize=12)\nax3.set_ylim(0, 20)\n\nax1.set_title('Full Fine-Tuning vs LoRA', fontsize=14, pad=20)\nax1.set_xticks(x)\nax1.set_xticklabels(methods, fontsize=12)\n\ndef autolabel(bars, ax, offset=0):\n    for bar in bars:\n        height = bar.get_height()\n        ax.annotate(f'{height:.1f}',\n                    xy=(bar.get_x() + bar.get_width()/2, height),\n                    xytext=(0, 3 + offset),\n                    textcoords=\"offset points\",\n                    ha='center', va='bottom', fontsize=11)\n\nautolabel(bars1, ax1)\nautolabel(bars2, ax2, 5)\nautolabel(bars3, ax3, 10)\n\nfig.legend(loc='upper center', bbox_to_anchor=(0.5, 0.95), ncol=3, fontsize=11)\nplt.tight_layout(rect=[0, 0, 1, 0.9])\nplt.grid(axis='y', alpha=0.3)\nplt.savefig('full_vs_lora_comparison.png', dpi=300, bbox_inches='tight')\nplt.show()",
