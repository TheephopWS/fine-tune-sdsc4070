    {
      "cell_type": "code",
      "source": "print(\"Start Full fine-tuning\")\nmodel_full = AutoModelForSequenceClassification.from_pretrained(\n    \"Qwen/Qwen2-0.5B\",\n    num_labels=2,\n    dtype=torch.bfloat16,\n    trust_remote_code=True\n)\n\nmodel_full.config.pad_token_id = tokenizer.pad_token_id\nmodel_full.config.use_cache = False\n\nmodel_full.gradient_checkpointing_enable()\n\ntraining_args_full = TrainingArguments(\n    output_dir=\"./qwen2-full\",\n    num_train_epochs=1,\n    per_device_train_batch_size=8,\n    per_device_eval_batch_size=8,\n    gradient_accumulation_steps=2,\n    learning_rate=5e-5,\n    eval_steps=500,\n    logging_steps=100,\n    bf16=True,\n    report_to=\"none\",\n)\n\ntrainer_full = Trainer(\n    model=model_full,\n    args=training_args_full,\n    train_dataset=tokenized[\"train\"].shuffle(seed=42).select(range(10000)),\n    eval_dataset=tokenized[\"test\"].shuffle(seed=42).select(range(2000)),\n    compute_metrics=compute_metrics,\n)\n\nstart = time.time()\ntorch.cuda.reset_peak_memory_stats()\ntrainer_full.train()\nfull_time = time.time() - start\nfull_mem = torch.cuda.max_memory_allocated() / 1e9\nfull_acc = trainer_full.evaluate()[\"eval_accuracy\"]\n\nprint(f\"Full Fine-tuning: Time: {full_time/60:.1f} min | Memory: {full_mem:.1f} GB | Acc: {full_acc*100:.1f}%\")\ndel model_full, trainer_full\ntorch.cuda.empty_cache()",
